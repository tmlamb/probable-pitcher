{
  "name": "@probable/expo",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "BETTER_AUTH_URL= expo start --clear --dev-client",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "build:dev": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit",
    "expo:fix": "expo install --check"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@date-fns/tz": "1.4.0",
    "@expo/metro-runtime": "~57.0.8",
    "@expo/vector-icons": "^15.1.1",
    "@legendapp/list": "^2.0.14",
    "@probable/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:",
    "expo": "~57.0.11",
    "expo-apple-authentication": "57.0.1",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.9",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-image": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-localization": "57.0.1",
    "expo-navigation-bar": "~57.0.2",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-secure-store": "57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.12",
    "expo-web-browser": "57.0.2",
    "nativewind": "5.0.0-preview.2",
    "posthog-react-native": "^4.17.1",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "0.86.2",
    "react-native-css": "3.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "semver": "^7.7.3",
    "superjson": "2.2.3",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@probable/api": "workspace:*",
    "@probable/eslint-config": "workspace:*",
    "@probable/prettier-config": "workspace:*",
    "@probable/tailwind-config": "workspace:*",
    "@probable/tsconfig": "workspace:*",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "~6.0.3"
  },
  "prettier": "@probable/prettier-config",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
